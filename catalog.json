    {
      "description": "The node's agent harness as a standard workload container on loopback, published through its tunnel.",
      "id": "agents.dsh",
      "name": "Node web UI (DeepSeek Harness)",
      "package": {
        "instanceModel": "singleton-per-machine",
        "role": "application"
      },
      "profiles": [
        "agent",
        "full"
      ],
      "requires": [
        "core",
        "runtime.podman"
      ],
      "version": 2,
      "workload": {
        "config": [
          "dsh_version",
          "channel",
          "port",
          "image",
          "mode",
          "dsh"
        ],
        "id": "dsh",
        "image": {
          "repo": "ghcr.io/softstone1/alwayswork-dsh",
          "version": {
            "channel": "latest",
            "config": "dsh_version",
            "package": "@deepseek-ai/dsh",
            "pinned": "0.1.5-rc.2",
            "source": "npm"
          }
        },
        "kind": "harness",
        "surfaces": [
          {
            "id": "dsh",
            "kind": "http",
            "name": "DeepSeek Harness",
            "path": "/",
            "port": 3080,
            "port_config": "port",
            "primary": true
          }
        ],
        "workspace": "subvolume"
      }
    },
