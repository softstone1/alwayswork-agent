#!/usr/bin/env bash
# alwayswork — secure, capability-based bootstrapper for Linux mini PCs.
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  target="$(readlink "$SELF")"
  if [[ "$target" == /* ]]; then SELF="$target"; else SELF="$(cd "$(dirname "$SELF")" && pwd)/$target"; fi
done
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
AW_ROOT="${AW_ROOT:-$(cd "$BIN_DIR/.." && pwd)}"
export AW_ROOT
# Prefer tools bundled beside the CLI: Arch packages the Python `yq`, which is
# not compatible with this project, so install.sh drops mikefarah's build here.
export PATH="$AW_ROOT/bin:$PATH"

# shellcheck source=../lib/core.sh
source "$AW_ROOT/lib/core.sh"
# shellcheck source=../lib/distro.sh
source "$AW_ROOT/lib/distro.sh"
# shellcheck source=../lib/ledger.sh
source "$AW_ROOT/lib/ledger.sh"
# shellcheck source=../lib/config.sh
source "$AW_ROOT/lib/config.sh"
# shellcheck source=../lib/hardware.sh
source "$AW_ROOT/lib/hardware.sh"
# shellcheck source=../lib/engine.sh
source "$AW_ROOT/lib/engine.sh"
# shellcheck source=../lib/firewall.sh
source "$AW_ROOT/lib/firewall.sh"
# shellcheck source=../lib/hardening.sh
source "$AW_ROOT/lib/hardening.sh"
# shellcheck source=../lib/secrets.sh
source "$AW_ROOT/lib/secrets.sh"
# shellcheck source=../lib/snapshot.sh
source "$AW_ROOT/lib/snapshot.sh"
# shellcheck source=../lib/capability.sh
source "$AW_ROOT/lib/capability.sh"
# shellcheck source=../lib/tunnel.sh
source "$AW_ROOT/lib/tunnel.sh"
# shellcheck source=../lib/power.sh
source "$AW_ROOT/lib/power.sh"
# shellcheck source=../lib/apps.sh
source "$AW_ROOT/lib/apps.sh"
# shellcheck source=../lib/cleanup.sh
source "$AW_ROOT/lib/cleanup.sh"
# shellcheck source=../lib/workload.sh
source "$AW_ROOT/lib/workload.sh"
# shellcheck source=../lib/control.sh
source "$AW_ROOT/lib/control.sh"
# shellcheck source=../lib/health.sh
source "$AW_ROOT/lib/health.sh"

# --- global flags -----------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "${1}" in
    --dry-run) DRY_RUN=1; shift ;;
    --yes|-y)  ASSUME_YES=1; shift ;;
    --json)    JSON_OUT=1; shift ;;
    --version|-V) printf 'alwayswork %s\n' "$AW_VERSION"; exit 0 ;;
    --help|-h) source "$AW_ROOT/commands/help.sh"; cmd_help; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown global flag: ${1} (try: aw help)" ;;
    *) break ;;
  esac
done

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift
# Footprint ledger attribution: entries name the command that made the
# change unless a caller (cap_install) narrows it further.
AW_LEDGER_BY="${AW_LEDGER_BY:-$cmd}"

case "$cmd" in
  init|bootstrap|apply|enable|disable|list|status|doctor|update|snapshot|secrets|capability|power|app|clean|enroll|reset|agent|decommission|provision|service|help)
    # shellcheck source=/dev/null
    source "$AW_ROOT/commands/$cmd.sh"
    "cmd_$cmd" "$@"
    ;;
  version) printf 'alwayswork %s\n' "$AW_VERSION" ;;
  *) die "unknown command: $cmd (try: aw help)" ;;
esac
